{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Madmail",
  "colors": {
    "primary": "#21453D",
    "light": "#E6FAF5",
    "dark": "#21453D"
  },
  "background": {
    "color": {
      "light": "#F5F5F5",
      "dark": "#181825"
    }
  },
