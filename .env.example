# REDIS_KEY_PREFIX=""

NEXT_PUBLIC_IS_CLOUD=true

# ---- Sentry (opcional) ----
# Sem DSN o SDK não inicializa e nada é enviado.
# SENTRY_DSN="https://xxxx@oYYYY.ingest.us.sentry.io/ZZZZ"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oYYYY.ingest.us.sentry.io/ZZZZ"
# SENTRY_ENVIRONMENT="development"
# Tracing desligado por padrão; 0.1 = 10% das requisições.
# SENTRY_TRACES_SAMPLE_RATE="0"
# Só no build, para subir sourcemaps e ver stack trace legível:
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
