# Variáveis da stack de produção. Copiar para /opt/madmail/.env no servidor.
#
#   cp env.example .env && chmod 600 .env
#
# Gerar segredos com: openssl rand -hex 32

# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_USER=madmail
POSTGRES_PASSWORD=            # OBRIGATÓRIO — openssl rand -hex 32
POSTGRES_DB=madmail

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_KEY_PREFIX=madmail

# ─── App ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://app.madmail.com.br
NEXTAUTH_SECRET=              # OBRIGATÓRIO — openssl rand -hex 32
                              # Cuidado: também é a chave que cifra as
                              # credenciais dos gateways no banco. Trocar
                              # depois inutiliza o que já estiver salvo.
NEXT_PUBLIC_IS_CLOUD=true
FROM_EMAIL=
ADMIN_EMAIL=                  # e-mail que ganha acesso ao /admin

# ─── AWS (mesma conta de hoje) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=            # OBRIGATÓRIO
AWS_SECRET_ACCESS_KEY=        # OBRIGATÓRIO
AWS_DEFAULT_REGION=sa-east-1  # região de ENVIO
INBOUND_S3_BUCKET=madmail-inbound-975049972225
INBOUND_S3_REGION=us-east-1   # inbound do SES só existe aqui

# ─── Storage de anexos/imagens (MinIO da infra da Evel) ───────────────────
S3_COMPATIBLE_ACCESS_KEY=
S3_COMPATIBLE_SECRET_KEY=
S3_COMPATIBLE_API_URL=        # ex: https://storage.evel.com.br
S3_COMPATIBLE_PUBLIC_URL=     # URL pública de leitura dos arquivos
S3_COMPATIBLE_BUCKET=madmail

# ─── Login social (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ─── Pagamentos ───────────────────────────────────────────────────────────
# Credenciais de Rede/Inter NÃO ficam aqui: são cadastradas cifradas no
# banco pela tela Admin > Pagamentos.
PAYMENTS_SANDBOX=false        # true = homologação Rede/Inter
PAYMENTS_WEBHOOK_TOKEN=       # RECOMENDADO — openssl rand -hex 32
                              # sem ele o webhook aceita qualquer POST
PAYMENT_LOG_RETENTION_DAYS=90 # mínimo aceito: 30

# ─── IA no editor ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── MCP ──────────────────────────────────────────────────────────────────
MCP_PUBLIC_URL=https://mcp.madmail.com.br/mcp
AUTH_SERVER_URL=https://app.madmail.com.br

# ─── Proxy / SSL ──────────────────────────────────────────────────────────
ACME_EMAIL=rafael@n49.com.br  # avisos de expiração do Let's Encrypt

# ─── Imagens (deixe em branco para usar :latest) ──────────────────────────
WEB_IMAGE=
MARKETING_IMAGE=
MCP_IMAGE=

# ─── Diversos ─────────────────────────────────────────────────────────────
API_RATE_LIMIT=1
AUTH_EMAIL_RATE_LIMIT=0
EMAIL_CLEANUP_DAYS=
