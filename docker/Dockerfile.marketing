# Build estático do site institucional (apps/marketing) e serve via nginx.
# Espelha a estratégia do docker/Dockerfile (turbo prune + build filtrado),
# mas o runner é nginx servindo o export estático (out/).
#
# Build (a partir da raiz do monorepo):
#   docker build -f docker/Dockerfile.marketing -t ghcr.io/<owner>/madmail-marketing:latest .

FROM node:22-alpine3.20 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
ENV SKIP_ENV_VALIDATION="true"
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

# --- Prune do monorepo para o workspace "marketing" ---
FROM base AS builder
RUN apk add --no-cache libc6-compat && apk update
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY ./apps/marketing ./apps/marketing
COPY ./packages ./packages
RUN pnpm add turbo@^2.5.2 -g
RUN pnpm turbo prune marketing --docker

# --- Instala deps e builda o export estático ---
FROM base AS installer
RUN apk add --no-cache libc6-compat && apk update
WORKDIR /app
COPY .gitignore .gitignore
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY --from=builder /app/out/full/ .
RUN pnpm turbo run build --filter=marketing...

# --- Runner: nginx servindo apps/marketing/out ---
FROM nginx:1.27-alpine AS runner
COPY docker/marketing-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=installer /app/apps/marketing/out /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
