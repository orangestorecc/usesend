# Porta do servidor MCP
PORT=8787

# Madmail (base da API pública). Local: http://localhost:3000/api
# Produção: https://app.madmail.com.br/api
USESEND_BASE_URL=http://localhost:3000/api

# Identidade deste servidor no OAuth (o "resource" anunciado aos clientes).
MCP_PUBLIC_URL=https://mcp.madmail.com.br/mcp

# Authorization Server anunciado no /.well-known/oauth-protected-resource.
AUTH_SERVER_URL=https://app.madmail.com.br

# Por quanto tempo os escopos de um token ficam em cache (ms).
# É o que define a janela entre revogar uma chave e ela parar de funcionar.
MCP_AUTH_CACHE_TTL_MS=60000

# Não existe token nem plano em variável de ambiente: as chaves msk_ vivem na
# tabela McpKey do banco, e é de lá que vêm time, escopos e plano.
