# Porta do servidor MCP
PORT=8787

# useSend (base da API pública). Local: http://localhost:3000/api
# Produção: https://app.madmail.com.br/api
USESEND_BASE_URL=http://localhost:3000/api

# Mapa token-de-MCP -> API key do useSend (por cliente).
# Formato: msk_<cliente>=<usesend_api_key>;msk_<outro>=<key>
MCP_TOKEN_MAP=msk_exemplo=us_xxx_yyy

# Planos por cliente (cobrança POR CONTATO):
# msk_<cliente>=nomePlano:precoPorContatoBRL:minContatos
MCP_PLANS=msk_exemplo=padrao:0.10:1000
